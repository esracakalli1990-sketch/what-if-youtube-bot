# What-If YouTube Bot — API Anahtarları
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

# Gemini API — https://aistudio.google.com
GEMINI_API_KEY=buraya_gemini_api_key_gelecek

# ElevenLabs — https://elevenlabs.io
ELEVENLABS_API_KEY=buraya_elevenlabs_api_key_gelecek
CHARACTER_VOICE_ID=buraya_voice_id_gelecek

# Replicate (FLUX/SDXL görsel üretimi) — https://replicate.com
REPLICATE_API_TOKEN=buraya_replicate_api_key_gelecek

# YouTube oynatma listesi (opsiyonel) — uzun videolar otomatik bu listeye eklenir
YOUTUBE_PLAYLIST_ID=

# Telegram bildirimleri (opsiyonel) — @BotFather'dan bot oluşturun
# Chat ID öğrenmek için: botunuza mesaj atın, sonra: python scripts/notifier.py --chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Görsel sağlayıcı seçimi (opsiyonel)
# IMAGE_MODE=manual → görselleri SİZ üretirsiniz: bot prompt'ları Telegram'dan
#   gönderir, görselleri Telegram'dan geri yollarsınız (maliyet: 0)
# IMAGE_PRIMARY=gemini → görseller önce Gemini API'den üretilir (faturalandırma gerekir)
# GEMINI_IMAGE_MODEL: gemini-2.5-flash-image (Nano Banana, ~$0.04/görsel)
#                     veya gemini-3-pro-image (Nano Banana Pro, en yüksek kalite)
IMAGE_MODE=
IMAGE_PRIMARY=
GEMINI_IMAGE_MODEL=
